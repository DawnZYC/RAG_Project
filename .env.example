# 复制此文件为 .env，填入你的配置
# 注意：.env 文件不要提交到 git

# ── 必填 ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── 可选（括号内为默认值）─────────────────────────────────────────────────────

# 使用的 LLM 模型
# 可选：gpt-4o-mini（便宜快速）、gpt-4o（质量更好）
LLM_MODEL=gpt-4o-mini

# 嵌入模型（本地运行，不消耗 API 费用）
# 英文文档：BAAI/bge-small-en-v1.5
# 中文文档：BAAI/bge-small-zh-v1.5
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# 检索后端
# native     — sentence-transformers + ChromaDB 直连（默认，透明，适合理解原理）
# llamaindex — LlamaIndex VectorStoreIndex + ChromaDB（支持 MMR 等高级检索策略）
# 注意：切换后端后需清空向量库并重新 ingest（embedding 格式不兼容）
#   rm -rf data/chroma/*
RAG_BACKEND=native

# LlamaIndex 检索模式（仅 RAG_BACKEND=llamaindex 时生效）
# similarity — 纯向量余弦相似度（默认，与 native 行为一致）
# mmr        — Maximal Marginal Relevance，减少结果内容重叠，提升多样性
RETRIEVAL_MODE=similarity

# MMR 多样性权重（仅 RETRIEVAL_MODE=mmr 时生效）
# 范围 0.0～1.0，值越小结果越多样，值越大结果越相关
# 推荐从 0.7 开始调试
MMR_THRESHOLD=0.7

# 数据存储路径（本地运行时相对于项目根目录）
CHROMA_DIR=data/chroma
PROCESSED_DIR=data/processed
DB_PATH=data/logs/queries.db
